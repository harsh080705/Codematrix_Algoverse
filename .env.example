# ============================================================================
# AIHub — Environment Configuration
# Copy this file to `.env` and adjust values for your environment.
# ============================================================================

# --- Core ---
NODE_ENV=development
PORT=8080

# --- Demo Mode Toggle ---
# On  = true  -> demo mode, in-memory store, no MongoDB required.
# Off = false -> full database-backed version.
DEMO_MODE=true

# --- Database (unused when DEMO_MODE=true) ---
MONGODB_URI=

# --- Auth Secrets (MUST be strong random values in production) ---
JWT_SECRET=aihub-demo-access-secret-32-chars!!
JWT_REFRESH_SECRET=aihub-demo-refresh-secret-32-chars

# --- x402 Payment ---
# Reachable facilitator that verifies and settles x402 payments.
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# algorand:testnet for local testing, algorand:mainnet for production.
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# Algorand address that receives payments (min 25 chars).
X402_PAY_TO=ALGORANDDEMOXXXXXXXXXXXXXXXXXXXXXX
# Settlement asset (USDC ASA).
X402_ASSET=USDC

# --- n8n Workflow Execution ---
# Backend-only webhook that receives authorized agent execution requests.
# Use the active workflow webhook URL from n8n:
# - test mode:    https://<your-n8n-domain>/webhook-test/agent-execute
# - production:   https://<your-n8n-domain>/webhook/agent-execute
N8N_WEBHOOK_URL=https://<your-n8n-domain>/webhook/agent-execute
# Shared secret used to sign backend -> n8n requests. Generate a strong random value.
N8N_SHARED_SECRET=replace-with-a-long-random-secret
# How long the backend waits for n8n before timing out the run.
N8N_TIMEOUT_MS=30000

# --- Algorand ---
ALGORAND_NETWORK=testnet
# Optional custom Algod node URL (defaults to AlgoNode when empty).
ALGORAND_NODE_URL=
# Optional custom Indexer URL.
ALGORAND_INDEXER_URL=

# --- Cloudinary (optional asset storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ---
# Frontend origin(s). Comma-separated list allowed.
CORS_ORIGIN=http://localhost:5173

# --- Frontend (apps/web/.env or Vercel env) ---
VITE_API_URL=http://localhost:8080
# --- AI Agents (Gemini preferred) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
